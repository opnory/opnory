# Gate 2 — TLS environment template
# Copy to .env and fill in values before deployment
# NEVER commit the filled .env file

# SeaweedFS / Tempo credentials (generated once, then persisted)
SEAWEEDFS_TEMPO_ACCESS_KEY=
SEAWEEDFS_TEMPO_SECRET_KEY=
SEAWEEDFS_SIGNING_KEY=

# Bootstrap admin (used once for bucket creation, then never exposed to Tempo)
SEAWEEDFS_ADMIN_ACCESS_KEY=
SEAWEEDFS_ADMIN_SECRET_KEY=

# Grafana admin password (optional; if unset, Grafana uses default admin/admin)
# GF_SECURITY_ADMIN_PASSWORD=