# Fastify trust proxy allowlist
# Default: ["127.0.0.1"] only
# In Gate 2 / production compose topology, Caddy sits in front of API on a Docker compose network.
# Set to the exact Caddy source IP/subnet (e.g., "172.20.0.0/16" or the specific compose subnet at deploy time).
# Comma-separated CIDRs or IPs. Do NOT use broad RFC1918 ranges.
OPNORY_TRUST_PROXY_CIDRS=

# CORS allowed origins
# Default: "http://localhost:3000" only
# Comma-separated exact origins. No wildcards. Must match the actual frontend/developer origin(s).
OPNORY_CORS_ORIGINS=
