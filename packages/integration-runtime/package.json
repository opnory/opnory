{
  "name": "@opnory/integration-runtime",
  "version": "0.1.0-spike",
  "description": "Capability runtime spike for provider-neutral extensibility",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:conformance": "bun test test/conformance-proof.test.ts"
  },
  "dependencies": {
    "@opnory/governance-core": "workspace:*",
    "@opnory/access-types": "workspace:*",
    "@opnory/observability": "workspace:*",
    "@opnory/config": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}