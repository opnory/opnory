{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "description": "Opnory one-host lab minimum ingress policy (ADR 0012). Consumed by the provider firewall resource and the ansible firewall role.",
  "inbound": [
    {"port": 22, "proto": "tcp", "source": "operator_cidr", "purpose": "ssh"},
    {"port": 80, "proto": "tcp", "source": "0.0.0.0/0", "purpose": "http-acme-redirect"},
    {"port": 443, "proto": "tcp", "source": "0.0.0.0/0", "purpose": "https"}
  ],
  "outbound": "allow-all",
  "default_inbound": "deny"
}
