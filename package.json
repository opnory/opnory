{
  "name": "opnory",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "bun test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "live:entra": "OPNORY_LIVE_GOVERNANCE_TESTS=true bun run scripts/live-governance/entra.ts",
    "live:okta": "OPNORY_LIVE_GOVERNANCE_TESTS=true bun run scripts/live-governance/okta.ts"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@octokit/auth-app": "^7.0.0",
    "@octokit/rest": "^21.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "zod": "^3.23.0"
  }
}
